# Copy to frontend/.env for local dev. These are baked into the JS bundle at
# build time (pass them as --build-arg to the Dockerfile), and none of them
# are secrets: they identify the Firebase project, they don't grant access.

# Firebase console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Go API.
VITE_BACKEND_URL=http://localhost:8080
