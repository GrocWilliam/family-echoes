# Copy to backend/.env for local dev. In deployment (e.g. Railway), set these
# as service variables instead — the API checks the required ones at startup.

# --- Firebase Admin SDK (verifies sign-in tokens) -------------------------
FIREBASE_PROJECT_ID=
# Local dev: path to the service-account JSON file (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Deployment alternative: paste the JSON file's contents instead.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Access control (comma-separated emails) ------------------------------
# Who may sign in and view albums.
ALLOWED_EMAILS=
# Who may upload, delete and rename. Each admin must also be in ALLOWED_EMAILS.
ADMIN_EMAILS=

# --- CORS ------------------------------------------------------------------
# Comma-separated frontend origins. 5173 is the Vite dev server.
FRONTEND_URL=http://localhost:5173

# --- Photo bucket (any S3-compatible storage: Railway bucket, R2, MinIO…) --
# Leave S3_ENDPOINT empty for AWS S3 itself.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Listen port (defaults to 8080; PaaS hosts usually set it for you).
# PORT=8080
